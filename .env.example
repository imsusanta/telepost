# ==========================================
# TelePost Environment Variables
# ==========================================
# Publishable frontend values only. Never put service_role, DB passwords,
# bot tokens, or Razorpay secrets here. Local builds fail closed if these
# two Vite keys are missing.

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Publishable / Anon API Key
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key-here"

# Supabase Project ID / Reference
VITE_SUPABASE_PROJECT_ID="your-project-id-here"
